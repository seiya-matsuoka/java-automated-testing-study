<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Spring Boot の Parent POM を利用し、Spring 関連ライブラリや
    Maven Plugin の互換性が取れたバージョン管理を Spring Boot 側へ委ねる。
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>java-automated-testing-study</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>java-automated-testing-study</name>
  <description>Java / Spring Boot automated testing study project</description>

  <properties>
    <!-- 学習・実行環境で使用する Java のメジャーバージョンを固定する。 -->
    <java.version>21</java.version>
    <!-- Unit 08 の HTTP Server 用 Test Double。Boot 管理外のため明示して固定する。 -->
    <wiremock.version>3.13.2</wiremock.version>
    <!-- Unit 09 の実 HTTP 入口の検証。Boot 管理外のため version を明示する。 -->
    <rest-assured.version>6.3.0</rest-assured.version>

    <!--
      通常の出力先は target とする。Coverage 計測や検証では target 内の専用ディレクトリを指定し、
      clean の範囲を今回の出力に限定する。過去 Unit の保存ログと計測結果を同じ場所で上書きしない。
    -->
    <study.build.directory>${project.basedir}/target</study.build.directory>

    <!--
      実 DB または実 HTTP を使う Unit 06〜09 の Test Class を選ぶ。
      Unit 08 の 2 クラスは package が異なるため個別に含める。
      同じパターンを Surefire で除外し、Failsafe で含めることで、verify での重複を防ぐ。
    -->
    <study.integration.tests>**/repository/jdbc/*Test.java,**/service/*IntegrationTest.java,**/client/HttpShippingFeeClientTest.java,**/service/OrderServiceShippingFeeHttpTest.java,**/api/*ApiTest.java</study.integration.tests>
  </properties>

  <dependencies>
    <!--
      Spring MVC ベースの REST API を構築するための Starter。
      Spring Boot 4 系で Web MVC に必要な構成をまとめて導入する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!--
      Request DTO などに Jakarta Bean Validation の制約を定義し、
      Controller の入力値検証に利用する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      NamedParameterJdbcTemplate を含む Spring JDBC の機能を利用する。
      Repository 層では SQL を明示的に記述し、PostgreSQL へアクセスする。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!--
      Java アプリケーションから PostgreSQL へ JDBC 接続するための Driver。
      実行時に必要な依存関係として runtime scope を指定する。
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Spring の同期 HTTP Client である RestClient を利用するための Starter。
      RestClient.Builder の Auto Configuration を含む HTTP Client 基盤を導入する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>

    <!--
      Unit 01 から使用する JUnit Jupiter。
      @Test、Assertions、Parameterized Test、Lifecycle Annotation などを提供する。
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 02 で fluent assertion を学ぶために AssertJ Core を追加する。
      Unit 03 以降でも、Test の state verification や exception verification に利用する。
    -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 05 で Spring MVC の Web 層だけを起動し、MockMvc による
      Request / Response / Validation / Exception Handler Test を行う。
      Spring Boot 4 系の Web MVC 専用 Test Starter を使用する。
      spring-test、Spring Boot Test、JSONPath、JSONassert などの Test 基盤を提供する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 08 では @RestClientTest で HTTP Client 用の Test Slice を構成する。
      実 RestClientConfig と Boot の Builder / JSON 変換を使用する。
      MockRestServiceServer は Test 側で無効にし、WireMock まで実 HTTP 通信を通す。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      外部 Shipping Fee API の HTTP 境界を、JUnit の JVM 内で再現する。
      依存の多くを shaded package に隔離する standalone 版を選び、Boot の依存との競合を抑える。
      配布形式の名前であり、別プロセスや Compose の Server を起動する指定ではない。
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      起動した Web Server へ HTTP Request を送り、Status / Header / JSON を検証する。
      MockMvc 連携ではなく通常の HTTP Client を使い、Jackson 3 を含む既存基盤を維持する。
    -->
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 06 では @JdbcTest で JDBC 用の Test Slice を構成する。
      Repository 自身の SQL を実 DB に通すための JdbcTemplate、Transaction、Test 基盤を利用する。
      Spring Data JDBC の Repository は使用していないため、jdbc-test の Starter を選ぶ。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers の Container を Spring Bean として管理し、
      @ServiceConnection でテスト専用 DB の接続情報を DataSource へ渡す。
      Container と Spring Test Context の存続期間を合わせるために利用する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      通常確認用 DB とは独立した実 PostgreSQL を Docker 上に用意する。
      Testcontainers 2 系の PostgreSQL Module を使用し、version は既存の Boot BOM に委ねる。
      Container は Spring が管理するため、Testcontainers の JUnit Extension は追加しない。
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 03 で Test Double / Mock / Stub / Spy / verification を学ぶための Mockito Core。
      mock()、when()、verify()、ArgumentCaptor などの中心 API を提供する。
    -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      JUnit Jupiter と Mockito を連携するための Extension。
      @ExtendWith(MockitoExtension.class) と @Mock / @InjectMocks / @Captor を組み合わせて利用する。
    -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <directory>${study.build.directory}</directory>
    <plugins>
      <!-- Spring Boot Application の実行・実行可能 JAR の作成に利用する。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        test phase は純粋な Unit Test と MockMvc の Web MVC Slice を担当する。
        MockMvc は Servlet の処理を通すが HTTP ポートを開かないため、DB や Server を準備せず実行できる。
        明示的な excludes を追加しても内部クラスの既定除外を保ち、@Nested は JUnit に外側のクラスから発見させる。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*$*</exclude>
            <exclude>${study.integration.tests}</exclude>
          </excludes>
          <!-- クラス候補が空の場合や、明示したクラス・メソッドに一致しない場合を検証の成功にしない。 -->
          <failIfNoTests>true</failIfNoTests>
          <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
        </configuration>
      </plugin>

      <!--
        Boot の親 POM が管理する version と integration-test / verify の execution を有効にする。
        integration-test で結果を記録し、post-integration-test を経由した後に verify で失敗を判定する。
        テストが起動する Server・Container の Lifecycle と Cleanup は、既存の Spring / JUnit 設定が管理する。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>${study.integration.tests}</include>
          </includes>
          <failIfNoTests>true</failIfNoTests>
          <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>coverage</id>
      <properties>
        <!-- clean verify を実行しても、通常の target 直下や過去 Unit の保存結果を削除しない。 -->
        <study.build.directory>${project.basedir}/target/unit10-coverage</study.build.directory>
        <jacoco.version>0.8.16</jacoco.version>
        <!--
          Agent 引数は Maven の goal が実行時に設定するため、テスト JVM の起動時に @{...} で読む。
          初期値は空にして、計測を skip した場合にも未展開の文字列が JVM に渡らないようにする。
          通常の argLine は別に読み、利用者が -DargLine で与えた JVM オプションと連結する。
        -->
        <jacoco.surefire.argLine></jacoco.surefire.argLine>
        <jacoco.failsafe.argLine></jacoco.failsafe.argLine>
        <argLine></argLine>
      </properties>
      <build>
        <plugins>
          <!-- 1 fork を再利用し、同じ実行グループ内の Class が 1 つの実行データに集まるようにする。 -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <forkCount>1</forkCount>
              <reuseForks>true</reuseForks>
              <argLine>@{jacoco.surefire.argLine} ${argLine}</argLine>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <forkCount>1</forkCount>
              <reuseForks>true</reuseForks>
              <argLine>@{jacoco.failsafe.argLine} ${argLine}</argLine>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <executions>
              <!-- Surefire の起動前に Agent 引数を準備し、その JVM の終了時に実行データを書き出す。 -->
              <execution>
                <id>prepare-surefire-coverage</id>
                <phase>initialize</phase>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
                <configuration>
                  <propertyName>jacoco.surefire.argLine</propertyName>
                  <destFile>${project.build.directory}/jacoco/surefire.exec</destFile>
                  <append>false</append>
                </configuration>
              </execution>

              <!--
                Failsafe の起動直前に別の Agent 引数と出力先を設定する。
                Unit 09 の組み込み Web Server は同じテスト JVM 内で動くため、HTTP 入口側の Java コードも計測される。
              -->
              <execution>
                <id>prepare-failsafe-coverage</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>prepare-agent-integration</goal>
                </goals>
                <configuration>
                  <propertyName>jacoco.failsafe.argLine</propertyName>
                  <destFile>${project.build.directory}/jacoco/failsafe.exec</destFile>
                  <append>false</append>
                </configuration>
              </execution>

              <!--
                test phase の既定の Surefire goal が終了してからレポートを生成する。
                -Dgroups=unit を付けると純粋な Unit Test の計測になる。指定しなければ Web MVC Slice も含む。
                HTML はソースの行・分岐の読解、XML はカウンターの比較に使う。
              -->
              <execution>
                <id>report-surefire-coverage</id>
                <phase>test</phase>
                <goals>
                  <goal>report</goal>
                </goals>
                <configuration>
                  <dataFile>${project.build.directory}/jacoco/surefire.exec</dataFile>
                  <outputDirectory>${project.build.directory}/site/jacoco-surefire</outputDirectory>
                  <formats>
                    <format>HTML</format>
                    <format>XML</format>
                  </formats>
                </configuration>
              </execution>

              <!--
                clean verify では専用ディレクトリの当回の 2 ファイルだけを使う。
                Failsafe の成功判定後に merge し、同じ verify phase 内で宣言順に全体 Report を作る。
                両プラグインの実行結果と両方の .exec がそろったことを確認してから全体 Coverage として読む。
              -->
              <execution>
                <id>merge-suite-coverage</id>
                <phase>verify</phase>
                <goals>
                  <goal>merge</goal>
                </goals>
                <configuration>
                  <fileSets>
                    <fileSet>
                      <directory>${project.build.directory}/jacoco</directory>
                      <includes>
                        <include>surefire.exec</include>
                        <include>failsafe.exec</include>
                      </includes>
                    </fileSet>
                  </fileSets>
                  <destFile>${project.build.directory}/jacoco/suite.exec</destFile>
                </configuration>
              </execution>
              <execution>
                <id>report-suite-coverage</id>
                <phase>verify</phase>
                <goals>
                  <goal>report</goal>
                </goals>
                <configuration>
                  <dataFile>${project.build.directory}/jacoco/suite.exec</dataFile>
                  <outputDirectory>${project.build.directory}/site/jacoco-suite</outputDirectory>
                  <formats>
                    <format>HTML</format>
                    <format>XML</format>
                  </formats>
                </configuration>
              </execution>

              <!--
                Report と同じ Production Class と suite.exec を使い、プロジェクト全体の Line / Branch 比率を判定する。
                phase を割り当てず、全体計測後に -Pcoverage と両方の最低値を付けて
                jacoco:check@check-suite-coverage を明示実行する。同じデータで閾値の違いを比較できる。
                データがなければ JaCoCo は Check を skip するため、判定メッセージまで確認する。
              -->
              <execution>
                <id>check-suite-coverage</id>
                <phase>none</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <dataFile>${project.build.directory}/jacoco/suite.exec</dataFile>
                  <haltOnFailure>true</haltOnFailure>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${coverage.minimum.line}</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>${coverage.minimum.branch}</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
