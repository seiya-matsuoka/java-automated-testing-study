<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Spring Boot の Parent POM を利用し、Spring 関連ライブラリや
    Maven Plugin の互換性が取れたバージョン管理を Spring Boot 側へ委ねる。
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>java-automated-testing-study</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>java-automated-testing-study</name>
  <description>Java / Spring Boot automated testing study project</description>

  <properties>
    <!-- 学習・実行環境で使用する Java のメジャーバージョンを固定する。 -->
    <java.version>21</java.version>
    <!-- Unit 08 の HTTP Server 用 Test Double。Boot 管理外のため明示して固定する。 -->
    <wiremock.version>3.13.2</wiremock.version>
  </properties>

  <dependencies>
    <!--
      Spring MVC ベースの REST API を構築するための Starter。
      Spring Boot 4 系で Web MVC に必要な構成をまとめて導入する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!--
      Request DTO などに Jakarta Bean Validation の制約を定義し、
      Controller の入力値検証に利用する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      NamedParameterJdbcTemplate を含む Spring JDBC の機能を利用する。
      Repository 層では SQL を明示的に記述し、PostgreSQL へアクセスする。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!--
      Java アプリケーションから PostgreSQL へ JDBC 接続するための Driver。
      実行時に必要な依存関係として runtime scope を指定する。
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Spring の同期 HTTP Client である RestClient を利用するための Starter。
      RestClient.Builder の Auto Configuration を含む HTTP Client 基盤を導入する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>

    <!--
      Unit 01 から使用する JUnit Jupiter。
      @Test、Assertions、Parameterized Test、Lifecycle Annotation などを提供する。
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 02 で fluent assertion を学ぶために AssertJ Core を追加する。
      Unit 03 以降でも、Test の state verification や exception verification に利用する。
    -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 05 で Spring MVC の Web 層だけを起動し、MockMvc による
      Request / Response / Validation / Exception Handler Test を行う。
      Spring Boot 4 系の Web MVC 専用 Test Starter を使用する。
      spring-test、Spring Boot Test、JSONPath、JSONassert などの Test 基盤を提供する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 08 では @RestClientTest で HTTP Client 用の Test Slice を構成する。
      実 RestClientConfig と Boot の Builder / JSON 変換を使用する。
      MockRestServiceServer は Test 側で無効にし、WireMock まで実 HTTP 通信を通す。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      外部 Shipping Fee API の HTTP 境界を、JUnit の JVM 内で再現する。
      依存の多くを shaded package に隔離する standalone 版を選び、Boot の依存との競合を抑える。
      配布形式の名前であり、別プロセスや Compose の Server を起動する指定ではない。
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 06 では @JdbcTest で JDBC 用の Test Slice を構成する。
      Repository 自身の SQL を実 DB に通すための JdbcTemplate、Transaction、Test 基盤を利用する。
      Spring Data JDBC の Repository は使用していないため、jdbc-test の Starter を選ぶ。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers の Container を Spring Bean として管理し、
      @ServiceConnection でテスト専用 DB の接続情報を DataSource へ渡す。
      Container と Spring Test Context の存続期間を合わせるために利用する。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      通常確認用 DB とは独立した実 PostgreSQL を Docker 上に用意する。
      Testcontainers 2 系の PostgreSQL Module を使用し、version は既存の Boot BOM に委ねる。
      Container は Spring が管理するため、Testcontainers の JUnit Extension は追加しない。
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Unit 03 で Test Double / Mock / Stub / Spy / verification を学ぶための Mockito Core。
      mock()、when()、verify()、ArgumentCaptor などの中心 API を提供する。
    -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      JUnit Jupiter と Mockito を連携するための Extension。
      @ExtendWith(MockitoExtension.class) と @Mock / @InjectMocks / @Captor を組み合わせて利用する。
    -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spring Boot Application の実行・実行可能 JAR の作成に利用する。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
